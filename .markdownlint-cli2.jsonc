{
  // Config for markdownlint-cli2 (`pnpm lint:md`).
  //
  // Scope: hand-written docs — docs/**, top-level README/AGENTS/CLAUDE, sample
  // READMEs. Generated content (books/, samples/*/out, LLM prompt files under
  // packages/tools/prompts, test fixtures) is deliberately not covered.
  //
  // MD013 (line length) is off: the docs predate the 80-column rule and
  // rewrapping every paragraph would bury real fixes in churn.
  // MD060 (table column padding style) is off: pure formatting, no correctness
  // impact. Every other rule stays at its default.
  "config": {
    "MD013": false,
    "MD060": false
  },
  "globs": ["docs/**/*.md", "README.md", "AGENTS.md", "CLAUDE.md", "samples/*/README.md"]
}
