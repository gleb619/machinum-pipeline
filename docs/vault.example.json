{
  "_comment": "Example vault with fake keys. Manage real vaults with `mt vault add` — see docs/vault.md.",
  "version": 1,
  "entries": {
    "local-ollama": {
      "provider": "ollama",
      "baseUrl": "http://localhost:11434",
      "models": ["llama3.1:8b", "qwen2.5:14b"],
      "defaultModel": "llama3.1:8b",
      "notes": "Fake example: stock local Ollama"
    },
    "my-openrouter": {
      "provider": "openrouter",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKeys": ["sk-or-v1-EXAMPLEKEYAAAA1111", "sk-or-v1-EXAMPLEKEYBBBB2222"],
      "headers": { "X-Title": "example-project" },
      "defaultModel": "openai/gpt-4o-mini",
      "notes": "Fake example: key pool"
    },
    "keepass-openrouter": {
      "provider": "openrouter",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKey": "keepass:EXAMPLE-OpenRouter-Key",
      "notes": "Fake example: key lives in a KeePass entry (see docs/vault.md)"
    },
    "embed-openrouter": {
      "provider": "openrouter",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKey": "embed:EXAMPLE-OpenRouter-Key",
      "notes": "Fake example: key lives in the embedded encrypted store (see docs/vault.md)"
    }
  }
}
