{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mt Pipeline Configuration",
  "type": "object",
  "properties": {
    "pipelines": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Pipeline file paths relative to project root"
    },
    "secretsEnvFile": {
      "type": "string",
      "description": "Path to .env file for secrets"
    },
    "retry": {
      "type": "object",
      "properties": {
        "maxAttempts": {
          "type": "number"
        },
        "backoff": {
          "type": "string",
          "enum": ["fixed", "exponential"]
        }
      }
    },
    "onError": {
      "type": "string",
      "enum": ["stop", "skip", "continue"]
    }
  }
}
