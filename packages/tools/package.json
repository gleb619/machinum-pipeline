{
  "name": "@mt/tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "gen:prompts": "node scripts/gen-prompts.mjs",
    "build": "node scripts/gen-prompts.mjs && tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "typecheck": "node scripts/gen-prompts.mjs && tsc --noEmit",
    "test": "node scripts/gen-prompts.mjs && vitest run",
    "test:gpu": "vitest run --config vitest.gpu.config.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@markschema/mdshape": "^1.0.0",
    "@mt/core": "workspace:*",
    "@rewdy/md-formatter": "^0.4.1",
    "compromise": "^14.19.0",
    "cspell-lib": "^8.0.0",
    "gpt-tokenizer": "^2.5.0",
    "gray-matter": "^4.0.3",
    "mdast-util-to-string": "^4.0.0",
    "openai": "^7.32.0",
    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tiktoken": "^1.0.22",
    "unified": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
