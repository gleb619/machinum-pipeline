    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@mt/core": "workspace:*",
    "gpt-tokenizer": "^2.5.0",
    "gray-matter": "^4.0.3",
    "unified": "^11.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
