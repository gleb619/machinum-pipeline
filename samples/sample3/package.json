{
  "name": "sample3",
  "version": "1.0.0",
  "description": "Machinum Pipeline sample — basic markdown processing with fork, subflow, range:// and void://",
  "type": "module",
  "scripts": {
    "runner": "NODE_OPTIONS='--import tsx' mt run ./pipelines/basic-md-processing.ts",
    "runner:range": "NODE_OPTIONS='--import tsx' mt run ./pipelines/basic-md-processing.ts --pipeline rangeDemoPipeline",
    "runner:void": "NODE_OPTIONS='--import tsx' mt run ./pipelines/basic-md-processing.ts --pipeline voidDemoPipeline",
    "prepare-input": "tsx prepare-input.ts",
    "example": "pnpm run prepare-input && pnpm run runner",
    "cleanup": "rm -rf output.md jsonl/input.jsonl .mt",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mt/core": "workspace:*",
    "@mt/cli": "workspace:*",
    "@mt/waypoint": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
