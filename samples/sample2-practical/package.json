{
  "name": "sample2-practical",
  "version": "1.0.0",
  "description": "Machinum Pipeline practical sample \u2014 prepare a real EN\u2192RU book translation (titles, glossary, summaries, chapters, assembled book)",
  "type": "module",
  "scripts": {
    "runner:normalization": "NODE_OPTIONS='--import tsx' mt run ./pipelines/normalization.ts",
    "runner:preparation": "NODE_OPTIONS='--import tsx' mt run ./pipelines/preparation.ts",
    "runner:translation": "NODE_OPTIONS='--import tsx' mt run ./pipelines/translation.ts",
    "runner:en": "NODE_OPTIONS='--import tsx' mt run ./pipelines/stages/extract-en.ts",
    "runner:stats": "NODE_OPTIONS='--import tsx' mt run ./pipelines/stages/stats.ts",
    "runner:split": "NODE_OPTIONS='--import tsx' mt run ./pipelines/stages/split.ts",
    "runner:quality": "NODE_OPTIONS='--import tsx' mt run ./pipelines/stages/quality.ts",
    "runner:preprocess": "NODE_OPTIONS='--import tsx' mt run ./pipelines/stages/preprocess.ts",
    "runner:titles": "NODE_OPTIONS='--import tsx' mt run ./pipelines/stages/translate-titles.ts",
    "runner:glossary": "NODE_OPTIONS='--import tsx' mt run ./pipelines/stages/glossary.ts",
    "runner:glossary-index": "NODE_OPTIONS='--import tsx' mt run ./pipelines/stages/glossary-index.ts",
    "runner:summary": "NODE_OPTIONS='--import tsx' mt run ./pipelines/stages/summary.ts",
    "runner:ner": "NODE_OPTIONS='--import tsx' mt run ./pipelines/stages/ner.ts",
    "runner:vocabulary": "NODE_OPTIONS='--import tsx' mt run ./pipelines/stages/vocabulary.ts",
    "runner:chapters": "NODE_OPTIONS='--import tsx' mt run ./pipelines/stages/translate-chapters.ts",
    "runner:assemble": "NODE_OPTIONS='--import tsx' mt run ./pipelines/stages/assemble.ts",
    "runner": "pnpm run runner:normalization && pnpm run runner:preparation && pnpm run runner:translation",
    "check-llm": "tsx check-llm.ts",
    "lint:parity": "tsx lint-parity.ts chapters/en chapters/ru",
    "backup": "tsx scripts/backup-run.ts",
    "book": "tsx scripts/run-book.ts",
    "compare": "tsx scripts/compare-runs.ts",
    "info": "mt info",
    "example": "pnpm run runner",
    "cleanup": "rm -rf chapters/en chapters/ru chapters/schema chapters/book chapters/titles.json chapters/glossary.json .mt .mt-translate-prompts.jsonl",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mt/cli": "workspace:*",
    "@mt/core": "workspace:*",
    "@mt/tools": "workspace:*",
    "@mt/waypoint": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
