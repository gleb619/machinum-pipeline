{
  "name": "sample2-practical",
  "version": "1.0.0",
  "description": "Machinum Pipeline practical sample \u2014 prepare a real EN\u2192RU book translation (titles, glossary, summaries, chapters, assembled book)",
  "type": "module",
  "scripts": {
    "runner:normalization": "NODE_OPTIONS='--import tsx' mt run ./pipelines/normalization.ts",
    "runner:preparation": "NODE_OPTIONS='--import tsx' mt run ./pipelines/preparation.ts",
    "runner:translation": "NODE_OPTIONS='--import tsx' mt run ./pipelines/translation.ts",
    "runner:en": "NODE_OPTIONS='--import tsx' mt run ./pipelines/normalization.ts --pipeline extractEn",
    "runner:stats": "NODE_OPTIONS='--import tsx' mt run ./pipelines/normalization.ts --pipeline stats",
    "runner:split": "NODE_OPTIONS='--import tsx' mt run ./pipelines/normalization.ts --pipeline split",
    "runner:quality": "NODE_OPTIONS='--import tsx' mt run ./pipelines/preparation.ts --pipeline quality",
    "runner:preprocess": "NODE_OPTIONS='--import tsx' mt run ./pipelines/preparation.ts --pipeline preprocess",
    "runner:titles": "NODE_OPTIONS='--import tsx' mt run ./pipelines/translation.ts --pipeline translateTitles",
    "runner:glossary": "NODE_OPTIONS='--import tsx' mt run ./pipelines/preparation.ts --pipeline glossary",
    "runner:glossary-index": "NODE_OPTIONS='--import tsx' mt run ./pipelines/preparation.ts --pipeline glossaryIndex",
    "runner:summary": "NODE_OPTIONS='--import tsx' mt run ./pipelines/preparation.ts --pipeline summary",
    "runner:ner": "NODE_OPTIONS='--import tsx' mt run ./pipelines/preparation.ts --pipeline ner",
    "runner:vocabulary": "NODE_OPTIONS='--import tsx' mt run ./pipelines/preparation.ts --pipeline vocabulary",
    "runner:chapters": "NODE_OPTIONS='--import tsx' mt run ./pipelines/translation.ts --pipeline translateChapters",
    "runner:assemble": "NODE_OPTIONS='--import tsx' mt run ./pipelines/translation.ts --pipeline assemble",
    "runner": "pnpm run runner:normalization && pnpm run runner:preparation && pnpm run runner:translation",
    "check-llm": "tsx check-llm.ts",
    "lint:parity": "tsx lint-parity.ts chapters/en chapters/ru",
    "backup": "tsx scripts/backup-run.ts",
    "book": "tsx scripts/run-book.ts",
    "compare": "tsx scripts/compare-runs.ts",
    "info": "mt info",
    "example": "pnpm run runner",
    "cleanup": "rm -rf chapters/en chapters/ru chapters/schema chapters/book chapters/titles.json chapters/glossary.json .mt .mt-translate-prompts.jsonl",
    "lint": "biome check .",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mt/cli": "workspace:*",
    "@mt/core": "workspace:*",
    "@mt/tools": "workspace:*",
    "@mt/waypoint": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
