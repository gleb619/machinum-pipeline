{
  "name": "sample2",
  "version": "1.0.0",
  "description": "Machinum Pipeline sample \u2014 basic markdown processing with fork, subflow, range:// and void://",
  "type": "module",
  "scripts": {
    "runner": "tsx run-all.ts",
    "runner:basic": "NODE_OPTIONS='--import tsx' mt run ./pipelines/basic-md-processing.ts",
    "runner:stats": "NODE_OPTIONS='--import tsx' mt run ./pipelines/basic-md-processing.ts --pipeline statsPipeline",
    "runner:custom": "NODE_OPTIONS='--import tsx' mt run ./pipelines/custom-md-processing.ts",
    "runner:range": "NODE_OPTIONS='--import tsx' mt run ./pipelines/custom-md-processing.ts --pipeline rangeDemoPipeline",
    "runner:void": "NODE_OPTIONS='--import tsx' mt run ./pipelines/custom-md-processing.ts --pipeline voidDemoPipeline",
    "prepare-input": "tsx prepare-input.ts",
    "example": "pnpm run prepare-input && pnpm run runner",
    "cleanup": "rm -rf output.md counts.jsonl jsonl/input.jsonl jsonl/entities.jsonl jsonl/ladder.jsonl chapters-out entities out .mt chapters/*.md chapters/glossary.graph.json",
    "lint": "biome check .",
    "lint:md": "markdownlint-cli2 --config ../../.markdownlint-cli2.jsonc out/runner-report.md",
    "test": "vitest run",
    "test:watch": "vitest",
    "runner:count": "NODE_OPTIONS='--import tsx' mt run ./pipelines/custom-md-processing.ts --pipeline countSidePipeline",
    "runner:ephemeral": "NODE_OPTIONS='--import tsx' mt run ./pipelines/custom-md-processing.ts --pipeline ephemeralDemoPipeline",
    "runner:entities": "NODE_OPTIONS='--import tsx' mt run ./pipelines/entity-md-processing.ts",
    "runner:branches": "NODE_OPTIONS='--import tsx' mt run ./pipelines/entity-md-processing.ts --pipeline parallelBranchesPipeline",
    "runner:chunks": "NODE_OPTIONS='--import tsx' mt run ./pipelines/chunk-normalization.ts",
    "runner:ladder": "NODE_OPTIONS='--import tsx' mt run ./pipelines/chunk-normalization.ts --pipeline ladderPipeline",
    "runner:tokens": "NODE_OPTIONS='--import tsx' mt run ./pipelines/chunk-normalization.ts --pipeline tokenLadderPipeline"
  },
  "dependencies": {
    "@mt/core": "workspace:*",
    "@mt/cli": "workspace:*",
    "@mt/tools": "workspace:*",
    "@mt/waypoint": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
