{
  "name": "sample1",
  "version": "1.0.0",
  "description": "Machinum Pipeline sample — HTTP to JSONL integration test",
  "type": "module",
  "scripts": {
    "runner:http": "NODE_OPTIONS='--import tsx' mt run ./pipelines/http-to-jsonl.ts",
    "runner:md": "NODE_OPTIONS='--import tsx' mt run ./pipelines/jsonl-to-md.ts",
    "simulate": "tsx simulation1.ts",
    "example": "tsx run-example.ts",
    "cleanup": "rm -rf jsonl/output.jsonl .mt chapters/en/*.md",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mt/core": "workspace:*",
    "@mt/cli": "workspace:*",
    "@mt/waypoint": "workspace:*",
    "@mt/tools": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
