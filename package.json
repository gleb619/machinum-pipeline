{
  "name": "machinum-pipeline",
  "private": true,
  "version": "0.1.0",
  "description": "Pluggable document processing orchestration engine",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo typecheck",
    "build:bin": "turbo build --filter=mt && pnpm --filter=mt run build:bin",
    "smoke:bin": "pnpm build:bin && pnpm --filter=mt run smoke:bin -- --no-build",
    "test": "turbo test && vitest run && pnpm -C samples/sample0 run test && pnpm -C samples/sample1 run test && pnpm -C samples/sample2 run test && pnpm -C samples/sample3 run test && pnpm -C samples/sample4 run test && pnpm -C samples/sample5 run test",
    "test:coverage": "turbo test:coverage",
    "test:gpu": "pnpm --filter=@mt/tools run test:gpu",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
