{
  "name": "machinum-pipeline",
  "private": true,
  "version": "0.1.0",
  "description": "Pluggable document processing orchestration engine",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "annotations": "tsx scripts/annotations.ts",
    "usecases": "tsx scripts/use-cases.ts",
    "waypoints": "tsx scripts/waypoints.ts",
    "tools": "tsx scripts/tools.ts",
    "lint": "biome check . && pnpm lint:md",
    "lint:md": "markdownlint-cli2 --config .markdownlint-cli2.jsonc && markdownlint-cli2 --config .markdownlint-cli2.reports.jsonc && tsx scripts/lint-mermaid.ts",
    "format": "biome check --write .",
    "typecheck": "pnpm --filter @mt/core build && tsc -p packages/tools/tsconfig.json --noEmit && turbo typecheck",
    "build:bin": "turbo build --filter=mt && pnpm --filter=mt run build:bin",
    "smoke:bin": "pnpm build:bin && pnpm --filter=mt run smoke:bin -- --no-build",
    "test": "turbo test && vitest run && pnpm -C samples/sample1-tutorial run test && pnpm -C samples/sample2-practical run test",
    "test:coverage": "turbo test:coverage",
    "ci:check": "bash scripts/wrkflw-guard.sh --quick",
    "ci:local": "pnpm lint && pnpm typecheck && bash scripts/wrkflw-guard.sh",
    "test:gpu": "pnpm --filter=@mt/tools run test:gpu",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@mermaid-js/mermaid-cli": "^12.2.0",
    "markdownlint-cli2": "^0.24.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
